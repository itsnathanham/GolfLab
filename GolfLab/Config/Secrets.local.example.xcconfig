// Copy this file to Secrets.local.xcconfig (same folder) and fill in values.
// Secrets.local.xcconfig is gitignored — do not commit it.

// In .xcconfig, // starts a comment, so use https:$()/$()/PROJECT_REF.supabase.co (not literal https://).
SUPABASE_URL = https:$()/$()/YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY = YOUR_SUPABASE_ANON_KEY
